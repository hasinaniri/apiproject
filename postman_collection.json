{
  "info": {
    "name": "API Etudiants",
    "description": "Collection pour tester l'API REST CRUD Etudiants",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "Hello World",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/"
      }
    },
    {
      "name": "Lister tous les etudiants",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/etudiants"
      }
    },
    {
      "name": "Lire un etudiant par id",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/etudiants/1"
      }
    },
    {
      "name": "Creer un etudiant",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/etudiants",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom\": \"Rakoto\",\n  \"prenom\": \"Jean\",\n  \"email\": \"jean.rakoto@example.com\"\n}"
        }
      }
    },
    {
      "name": "Modifier un etudiant (PUT)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/etudiants/1",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom\": \"Rakoto\",\n  \"prenom\": \"Jean-Paul\",\n  \"email\": \"jp.rakoto@example.com\"\n}"
        }
      }
    },
    {
      "name": "Modifier un etudiant (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/etudiants/1",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prenom\": \"Paul\"\n}"
        }
      }
    },
    {
      "name": "Supprimer un etudiant",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/etudiants/1"
      }
    }
  ]
}
